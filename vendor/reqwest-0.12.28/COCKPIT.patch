     fn clone_request(&mut self, req: &Req) -> Option<Req> {
+        #[cfg(feature = "cockpit-connect-retry")]
+        if self.cockpit_setup_only && req.uri().scheme_str() == Some("https")
+            && req.uri().host().is_some_and(|host| host.eq_ignore_ascii_case("chatgpt.com"))
+            && req.method() != http::Method::CONNECT && !req.headers().contains_key(http::header::UPGRADE)
+        {
+            // Do not even clone the body: the local setup contract ends at the
+            // first send, including protocol NACKs normally replayed by reqwest.
+            return None;
+        }
         if self.retry_cnt > 0 && !self.scope.applies_to(req) {
             return None;
         }
